# 仓库根 = html-ppt/：backend/ 与将来的 frontend/ 共用这一个仓库。

# 运行期产物
*.tmp
*.exe

# 本地工具状态（ZCode 会话与计划文件）
.zcode/

# 迁移前 .git 的完整备份，确认历史无误后可直接删除
.git-backup/

# 一次性排查脚本（这两个文件原本就注明"放在仓库外层，不进 git"）；
# 想纳入版本管理的话，删掉下面两行即可
csp-probe.js
deck-shape-audit.mjs

# 根目录 font/ 是 backend/web/assets/fonts/jetbrains-maple-mono/ 的字节级副本（共 20M），
# 真正的字体资源已随 backend/ 入库，这里不再重复跟踪
font/

# 前端（Vite 开发服务器见 backend/config.yaml 的 allow_origins: localhost:5173）
node_modules/
dist/
.vite/

# 说明：backend/config.yaml（含数据库/LLM/JWT/SMTP 等真实密钥）与 backend/data/
# 由 backend/.gitignore 覆盖，不进版本管理。
